# Set colors
autoload -U colors && colors
sbold="%B"
rbold="%b"
rsf="%f"
rsk="%k"
rsa="%f%k"
fblack="%F{0}"
fred="%F{9}"
fgreen="%F{76}"
forange="%F{214}"
fgrey="%F{237}"
bblack="%K{0}"
bred="%K{9}"
bgreen="%K{76}"
borange="%K{214}"
bgrey="%K{237}"

# Enabling and setting git info var to be used in prompt config.
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git svn
# This line obtains information from the vcs.
zstyle ':vcs_info:git*' formats "%b%c%u"
zstyle ':vcs_info:git*' actionformats "%b %a%c%u"
# Enable substitution in the prompt.
setopt prompt_subst

# Set ret value
RET_VALUE=0
precmd() {
    RET_VALUE="$?"
    vcs_info
}

# Ahead/behind counts for the current branch (empty if up to date)
git_ab() {
    local st a=0 b=0
    st=$(LC_ALL=C git status -sb 2>/dev/null | head -n1)
    [[ $st == *'['*']'* ]] || return 0
    st=${st#*\[}; st=${st%]*}
    [[ $st == *ahead* ]] && { a=${st##*ahead\ }; a=${a%%[ ,]*}; }
    [[ $st == *behind* ]] && { b=${st##*behind\ }; b=${b%%[ ,]*}; }
    (( a > 0 || b > 0 )) && print -nr "↑${a}↓${b} "
    return 0
}

# Set prompt
prompt () {
    PROMPT=""
    #Ret value (only shown on error)
    if [ "${RET_VALUE}" -ne 0 ]; then
        PROMPT+="${bred}${fblack}${sbold}${RET_VALUE}${rbold} ${rsa}${borange}${fred}${rsa}"
    fi
    #Directory
    PROMPT+="${borange}${fblack} ${sbold}%~${rbold} ${rsa}"
	PROMPT+="${forange}${rsf} "

	# Right Prompt
	RPROMPT=""
    #Git branch
    if [ "${vcs_info_msg_0_}" ]; then
		RPROMPT+="${fgrey}${rsf}${bgrey}${forange}${sbold} ${vcs_info_msg_0_} $(git_ab) ${rbold}${rsa}"
		RPROMPT+="${bgrey}${forange}${rsa}"
    else
		RPROMPT+="${forange}${rsf}"
    fi
	RPROMPT+="${borange}${fblack}${sbold} %* ${rbold}${rsa}"
}

# Init prompt
precmd_functions+=(prompt)

# Remove right useless space
ZLE_RPROMPT_INDENT=0

# Continuation prompt
PS2="${fgrey}└ ${rsf} "

# History parameters:
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=${HOME}/.zsh_history
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt NO_BEEP
# Avoid ctrl+s freezing the terminal
unsetopt flow_control

# Word movement: stop at / . -
WORDCHARS='*?_=[]{}~+-'

# Directory stack: every cd pushes, d to list, cd -N to jump back
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
alias d='dirs -v'

# Basic auto/tab complete:
autoload -U compinit
zmodload zsh/complist
if [[ -n ${ZSH_COMP_DAY:-} && ${ZSH_COMP_DAY} -eq $(date +%Y%m%d) ]]; then
    :
else
    mkdir -p ${HOME}/.cache/zsh
    compinit -d ${HOME}/.cache/zsh/zcompdump
    ZSH_COMP_DAY=$(date +%Y%m%d)
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' completer _expand_alias _complete _approximate
zstyle ':completion:*' approx 2
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- No matches --%f'
_comp_options+=(globdots)

# vi mode
# bindkey -v

# Set key delay to 10ms
export KEYTIMEOUT=1

# Enable reverse search
bindkey '^R' history-incremental-search-backward

# Use vim keys in tab complete menu:
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect 'j' vi-down-line-or-history

# Jump next word
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# Shift+tab: reverse menu complete
bindkey '^[[Z' reverse-menu-complete

# Use lf to switch directories and bind it to ctrl-o
lfcd () {
    tmp="$(mktemp)"
    lf -last-dir-path="$tmp" "$@"
    if [ -f "$tmp" ]; then
        dir="$(cat "$tmp")"
        rm -f "$tmp"
        [ -d "$dir" ] && [ "$dir" != "$(pwd)" ] && cd "$dir"
    fi
}

bindkey -s '^o' 'lfcd\n'

# Edit line in vim with ctrl-e:
autoload edit-command-line; zle -N edit-command-line
bindkey '^e' edit-command-line

# Plugins
[[ -f ${HOME}/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    source ${HOME}/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
[[ -f ${HOME}/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source ${HOME}/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f ${HOME}/.zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]] && \
    source ${HOME}/.zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
# fzf (if installed: ^F files, ^R fuzzy history, ^T cd)
if command -v fzf >/dev/null; then
    source <(fzf --zsh)
    bindkey '^F' fzf-file-widget
    bindkey '^T' fzf-cd-widget
fi

# Load aliases
if [ -f ${HOME}/.zsh_aliases ]; then
    source ${HOME}/.zsh_aliases
fi

# Export
export EDITOR=nvim
export VISUAL=nvim
export LESS='-R -F -X'
export PAGER=less
